# Owen HR Portal environment variables.
# Copy this file to .env.local for local development and fill in the values.
# Never commit .env.local. In production, set these in the Vercel project settings.

# Supabase project URL: Project Settings > Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key: Project Settings > API Keys. Either the "anon" (legacy) key or a
# "publishable" (sb_publishable_...) key works. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET: service role key, or a secret key (sb_secret_...). Server-only; used to
# invite users and to enable/disable logins. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of this app. Used in invite and password-reset email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
